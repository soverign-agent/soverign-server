# Server Configuration
SERVER_ENV=development
SERVER_LOG_LEVEL=debug

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=sovereign-dev-password
POSTGRES_DATABASE=sovereign
POSTGRES_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Temporal
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_TLS_DISABLE=true

# LLM API Keys (add your own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Encryption (for storing credentials like Git repo access tokens)
ENCRYPTION_MASTER_KEY=change-this-to-32-byte-key-in-production

# JWT (use RS256 in production with proper key pairs)
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem

# Observability
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_PORT=3000
